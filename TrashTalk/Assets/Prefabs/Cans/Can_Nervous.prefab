MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4660403928884271177}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16d7d4531ad8546e19102fc576213300, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrashCan
  Kind: 5
  LidOpen: 0
  w: 1.3
  h: 1.6
  tint: {r: 1, g: 0.85, b: 0.3, a: 1}
  voice: 1.6
  talk:
  - evt: hello
    lines:
    - H-h-hi... be gentle?
    - I-is that a ROCKET?
    - Um. Hi. Please don't.
  - evt: near
    lines:
    - N-n-not me!
    - R-r-rocket!
    - Too close! TOO CLOSE!
  - evt: score
    lines:
    - I-I did it?!
    - Oh! Oh! Yummy!
    - W-wow, thanks!
  - evt: reject
    lines:
    - Ew! Not my diet!
    - Wrong bin, buddy!
    - Ptooey!
    - Return to sender!
    - Do I LOOK like that bin?
    - Nope. Not eating that.
  - evt: miss
    lines:
    - Ph-phew... missed.
    - O-oh no, litter!
    - W-was that on purpose?
  - evt: rim
    lines:
    - Y-yikes!
    - Th-that tickled!
  - evt: win
    lines:
    - W-we survived!
  - evt: lose
    lines:
    - S-sorry you lost!
  - evt: nap
    lines:
    - Zzz...
    - Five more minutes...
    - Lid's shut. Go away.
  - evt: wake
    lines:
    - '*yawn* Huh? Food?'
    - Wha? I'm up! I'm up!
    - Mm... snack time?
  - evt: scared
    lines:
    - AAH!
    - N-n-not me!
    - Too close! TOO CLOSE!
    - M-mommy!
    - EEP!
  - evt: hit
    lines:
    - OOF!
    - You'll pay for that!
    - Lucky shot!
    - ARGH! My lid!
  - evt: bossIntro
    lines:
    - I AM THE MEGA DUMPSTER!
  openRange: 4.5
  lookRange: 14
  talkCooldown: 1.6
  napTime: 3
  awakeTime: 2
  bubble: {fileID: 7163041435242196611}
  bubbleText: {fileID: 394097918275904166}
  lidHinge: {fileID: 656484784168773151}
