--- !u!114 &5178182098476508307
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4364054666405457267}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16d7d4531ad8546e19102fc576213300, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrashCan
  Kind: 0
  LidOpen: 0
  w: 1.3
  h: 1.6
  tint: {r: 0.6039216, g: 0.64705884, b: 0.69411767, a: 1}
  voice: 1
  talk:
  - evt: hello
    lines:
    - Hi! I'm a can. Can-do!
    - Feed me, rocket boy!
    - Talk trash to me!
    - Toss it here, champ!
  - evt: near
    lines:
    - Ooh, incoming!
    - Open wide! AHH!
    - Here comes the snack!
    - Choo choo! Trash train!
    - Right in the mouth!
  - evt: score
    lines:
    - Yum! Garbage-licious!
    - Nothing but bin!
    - Chef's kiss! *chomp*
    - Delicious debris!
    - Bin-go!
    - Refuse to lose!
    - Om nom nom!
    - Tastes like victory!
  - evt: reject
    lines:
    - Ew! Not my diet!
    - Wrong bin, buddy!
    - Ptooey!
    - Return to sender!
    - Do I LOOK like that bin?
    - Nope. Not eating that.
  - evt: miss
    lines:
    - Ha! Litterbug!
    - You throw like a lid!
    - Swing and a miss!
    - The ground's not a bin!
    - Wow. Just... wow.
    - Trash aim, buddy!
    - Missed me by a mile!
  - evt: rim
    lines:
    - Ooh, rim!
    - Off the rim!
    - Clang! So close!
    - Almost had it!
  - evt: win
    lines:
    - Spotless! I'm stuffed.
    - Best meal ever!
    - Clean streets! Woo!
    - You're a pro-tosser!
    - Bin there, won that!
  - evt: lose
    lines:
    - Total dumpster fire!
    - You're garbage at this!
    - Trash talk 1, you 0!
    - Litter-ally the worst!
    - Rocket science is hard?
  - evt: nap
    lines:
    - Zzz...
    - Five more minutes...
    - Lid's shut. Go away.
  - evt: wake
    lines:
    - '*yawn* Huh? Food?'
    - Wha? I'm up! I'm up!
    - Mm... snack time?
  - evt: scared
    lines:
    - AAH!
    - Too close! TOO CLOSE!
    - Rocket! RUN!
    - Eek!
  - evt: hit
    lines:
    - OOF!
    - You'll pay for that!
    - Lucky shot!
    - ARGH! My lid!
  - evt: bossIntro
    lines:
    - I AM THE MEGA DUMPSTER!
  openRange: 4.5
  lookRange: 14
  talkCooldown: 1.6
  napTime: 3
  awakeTime: 2
  bubble: {fileID: 5117502201005560895}
  bubbleText: {fileID: 4081718662371724385}
  lidHinge: {fileID: 4896802519531887794}
  pupilL: {fileID: 5390785652650445165}
  pupilR: {fileID: 6032537617202219889}
  lidCol: {fileID: 2308098320246175135}
  anim: {fileID: 0}
