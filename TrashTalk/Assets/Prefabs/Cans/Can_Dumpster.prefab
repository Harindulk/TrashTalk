--- !u!114 &3873944492664794731
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6262420528556925978}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16d7d4531ad8546e19102fc576213300, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrashCan
  Kind: 4
  LidOpen: 0
  w: 2.86
  h: 1.84
  tint: {r: 0.18431373, g: 0.41960785, b: 0.30980393, a: 1}
  voice: 0.65
  talk:
  - evt: hello
    lines:
    - OI! FEED THE BIG GUY!
    - I EAT ANYTHING! TRY ME!
    - GIMME! GIMME ALL OF IT!
  - evt: near
    lines:
    - OPEN WIDE! AAAH!
    - BRING IT, SPACE CADET!
  - evt: score
    lines:
    - MORE! MORE!
    - THAT ALL YOU GOT?
    - BURP! 'SCUSE ME!
    - DELICIOUS GARBAGE!
  - evt: reject
    lines:
    - Ew! Not my diet!
    - Wrong bin, buddy!
    - Ptooey!
    - Return to sender!
    - Do I LOOK like that bin?
    - Nope. Not eating that.
  - evt: miss
    lines:
    - HAHA! TRASH AIM!
    - MY GRANDMA AIMS BETTER!
    - BOO! LITTERBUG!
    - WHAT WAS THAT?!
    - EVEN I'M EMBARRASSED!
  - evt: rim
    lines:
    - SO CLOSE! HAHA!
    - CLANG! LOL!
  - evt: win
    lines:
    - STUFFED! GOOD GAME!
    - OK OK, YOU'RE GOOD!
  - evt: lose
    lines:
    - TOTAL DUMPSTER FIRE!
    - YOU'RE GARBAGE AT THIS!
    - I'D KNOW. I'M TRASH!
    - GO HOME, LITTERBUG!
  - evt: nap
    lines:
    - Zzz...
    - Five more minutes...
    - Lid's shut. Go away.
  - evt: wake
    lines:
    - '*yawn* Huh? Food?'
    - Wha? I'm up! I'm up!
    - Mm... snack time?
  - evt: scared
    lines:
    - AAH!
    - Too close! TOO CLOSE!
    - Rocket! RUN!
    - Eek!
  - evt: hit
    lines:
    - OOF!
    - You'll pay for that!
    - Lucky shot!
    - ARGH! My lid!
  - evt: bossIntro
    lines:
    - I AM THE MEGA DUMPSTER!
  openRange: 4.5
  lookRange: 14
  talkCooldown: 1.6
  napTime: 3
  awakeTime: 2
  bubble: {fileID: 4911524834492370567}
  bubbleText: {fileID: 130375606775236016}
  lidHinge: {fileID: 3847432824615061268}
  pupilL: {fileID: 6263381678942834796}
  pupilR: {fileID: 8218304955521585012}
  lidCol: {fileID: 3577605706600246214}
  anim: {fileID: 0}
