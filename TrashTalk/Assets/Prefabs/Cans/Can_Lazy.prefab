--- !u!114 &6360040424881345007
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2553388863547599271}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16d7d4531ad8546e19102fc576213300, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrashCan
  Kind: 1
  LidOpen: 0
  w: 1.3
  h: 1.6
  tint: {r: 0.62, g: 0.52, b: 0.78, a: 1}
  voice: 0.75
  talk:
  - evt: hello
    lines:
    - '*yawn* ...hey.'
    - Wake me at lunch.
    - Mmh. Nap first.
  - evt: near
    lines:
    - Mm? Food?
    - Ugh, fine. Open.
  - evt: score
    lines:
    - Mm... comfy snack.
    - Nice. Back to bed.
    - Breakfast in bed!
  - evt: reject
    lines:
    - Ew! Not my diet!
    - Wrong bin, buddy!
    - Ptooey!
    - Return to sender!
    - Do I LOOK like that bin?
    - Nope. Not eating that.
  - evt: miss
    lines:
    - Meh. Too far to care.
    - Zzz... missed, huh?
  - evt: rim
    lines:
    - Ooh, rim!
    - Off the rim!
    - Clang! So close!
    - Almost had it!
  - evt: win
    lines:
    - Cool. Nap time.
  - evt: lose
    lines:
    - Wake me next time.
  - evt: nap
    lines:
    - Zzz...
    - Five more minutes...
    - Lid's shut. Go away.
  - evt: wake
    lines:
    - '*yawn* Huh? Food?'
    - Wha? I'm up! I'm up!
    - Mm... snack time?
  - evt: scared
    lines:
    - AAH!
    - Too close! TOO CLOSE!
    - Rocket! RUN!
    - Eek!
  - evt: hit
    lines:
    - OOF!
    - You'll pay for that!
    - Lucky shot!
    - ARGH! My lid!
  - evt: bossIntro
    lines:
    - I AM THE MEGA DUMPSTER!
  openRange: 4.5
  lookRange: 14
  talkCooldown: 1.6
  napTime: 2
  awakeTime: 3
  bubble: {fileID: 5342570705424281960}
  bubbleText: {fileID: 3458161641544534983}
  lidHinge: {fileID: 7194577858268433726}
