--- !u!114 &8819398095760615591
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 187833615112453577}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16d7d4531ad8546e19102fc576213300, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrashCan
  Kind: 6
  LidOpen: 0
  w: 4.5499997
  h: 3.5200002
  tint: {r: 0.110588245, g: 0.2517647, b: 0.18588236, a: 1}
  voice: 0.5
  talk:
  - evt: hello
    lines:
    - I AM THE MEGA DUMPSTER!
    - BOW BEFORE MY LID!
    - YOUR TRASH IS MINE!
  - evt: near
    lines:
    - FEED ME, MORTAL!
    - IS THAT ALL?!
    - MY HUNGER IS ENDLESS!
    - COME CLOSER... HEH.
    - I SMELL A ROCKET!
  - evt: score
    lines:
    - OOF! LUCKY SHOT!
    - IMPOSSIBLE!
  - evt: reject
    lines:
    - Ew! Not my diet!
    - Wrong bin, buddy!
    - Ptooey!
    - Return to sender!
    - Do I LOOK like that bin?
    - Nope. Not eating that.
  - evt: miss
    lines:
    - MWAHAHA! PATHETIC!
    - IS THAT YOUR BEST?!
    - MY MINIONS SAW THAT!
  - evt: rim
    lines:
    - HA! DENIED!
  - evt: win
    lines:
    - NOOO! I'M... FULL!
    - DEFEATED BY... RECYCLING?!
  - evt: lose
    lines:
    - MWAHAHA! TRASH WINS!
    - BOW TO THE DUMPSTER!
  - evt: nap
    lines:
    - Zzz...
    - Five more minutes...
    - Lid's shut. Go away.
  - evt: wake
    lines:
    - '*yawn* Huh? Food?'
    - Wha? I'm up! I'm up!
    - Mm... snack time?
  - evt: scared
    lines:
    - AAH!
    - Too close! TOO CLOSE!
    - Rocket! RUN!
    - Eek!
  - evt: hit
    lines:
    - OOF! LUCKY SHOT!
    - IMPOSSIBLE!
    - MY BEAUTIFUL LID!
    - YOU'LL PAY FOR THAT!
    - ARGH! ...TASTY THOUGH.
  - evt: bossIntro
    lines:
    - I AM THE MEGA DUMPSTER!
    - BOW BEFORE MY LID!
  openRange: 4.5
  lookRange: 14
  talkCooldown: 1.6
  napTime: 3
  awakeTime: 2
  bubble: {fileID: 6348298654530269356}
  bubbleText: {fileID: 5134016062098649123}
  lidHinge: {fileID: 5870219227828919756}
  pupilL: {fileID: 6022279745659211109}
  pupilR: {fileID: 6191914634308114563}
  lidCol: {fileID: 201015060033938063}
  anim: {fileID: 0}
