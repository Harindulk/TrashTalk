--- !u!114 &850453158643002694
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 380729068837926302}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16d7d4531ad8546e19102fc576213300, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrashCan
  Kind: 3
  LidOpen: 0
  w: 1.3
  h: 1.6
  tint: {r: 0.24705882, g: 0.6392157, b: 0.3019608, a: 1}
  voice: 0.9
  talk:
  - evt: hello
    lines:
    - Peace, love, peels.
    - Feed me fruit, dude.
    - Organic vibes only.
    - Namaste, little rocket.
  - evt: near
    lines:
    - Whoa, incoming, dude!
    - Far out, a snack!
  - evt: score
    lines:
    - Rad! So organic!
    - Totally rotten, man!
    - Good vibes, good worms.
    - Far out! *munch*
  - evt: reject
    lines:
    - Plastic? Bad vibes, man.
    - Whoa, not cool, dude.
    - Not compostable, bro.
  - evt: miss
    lines:
    - Bummer, dude.
    - The earth felt that, man.
    - Not chill, dude.
  - evt: rim
    lines:
    - Ooh, rim!
    - Off the rim!
    - Clang! So close!
    - Almost had it!
  - evt: win
    lines:
    - Groovy! Soil for days!
  - evt: lose
    lines:
    - Harsh vibes, man.
  - evt: nap
    lines:
    - Zzz...
    - Five more minutes...
    - Lid's shut. Go away.
  - evt: wake
    lines:
    - '*yawn* Huh? Food?'
    - Wha? I'm up! I'm up!
    - Mm... snack time?
  - evt: scared
    lines:
    - AAH!
    - Too close! TOO CLOSE!
    - Rocket! RUN!
    - Eek!
  - evt: hit
    lines:
    - OOF!
    - You'll pay for that!
    - Lucky shot!
    - ARGH! My lid!
  - evt: bossIntro
    lines:
    - I AM THE MEGA DUMPSTER!
  openRange: 4.5
  lookRange: 14
  talkCooldown: 1.6
  napTime: 3
  awakeTime: 2
  bubble: {fileID: 3466700137139752525}
  bubbleText: {fileID: 3932634607343535440}
  lidHinge: {fileID: 4632508902439459580}
  pupilL: {fileID: 8874979079869533000}
  pupilR: {fileID: 5573876803823261436}
  lidCol: {fileID: 4779739258843378393}
  anim: {fileID: 0}
