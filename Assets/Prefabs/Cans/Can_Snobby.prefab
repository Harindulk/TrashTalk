--- !u!114 &3330585644154345510
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4674242854018881096}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16d7d4531ad8546e19102fc576213300, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrashCan
  Kind: 2
  LidOpen: 0
  w: 1.3
  h: 1.6
  tint: {r: 0.23921569, g: 0.54509807, b: 0.8784314, a: 1}
  voice: 1.3
  talk:
  - evt: hello
    lines:
    - Recycling only, darling.
    - Is that... food? Ew.
    - Plastic? How divine.
    - I only dine on bottles.
  - evt: near
    lines:
    - Gently, please!
    - Mind the paintwork!
    - Easy, peasant!
  - evt: score
    lines:
    - Mm, vintage plastic.
    - Recycled. Magnifique!
    - Exquisite rubbish.
    - A fine year for soda.
  - evt: reject
    lines:
    - Ew. Compost, darling.
    - Banana? How DARE you.
    - I'm a recycler, peasant!
    - Not on my lid, sweetie.
    - Food?! Call my lawyer!
  - evt: miss
    lines:
    - How dreadfully common.
    - Tacky. Very tacky.
    - Littering? Barbaric.
  - evt: rim
    lines:
    - Mind my finish!
    - Watch the chrome!
  - evt: win
    lines:
    - Adequate. Barely.
    - Simply sustainable!
  - evt: lose
    lines:
    - Disappointing, darling.
    - Utterly un-recyclable.
  - evt: nap
    lines:
    - Zzz...
    - Five more minutes...
    - Lid's shut. Go away.
  - evt: wake
    lines:
    - '*yawn* Huh? Food?'
    - Wha? I'm up! I'm up!
    - Mm... snack time?
  - evt: scared
    lines:
    - AAH!
    - Too close! TOO CLOSE!
    - Rocket! RUN!
    - Eek!
  - evt: hit
    lines:
    - OOF!
    - You'll pay for that!
    - Lucky shot!
    - ARGH! My lid!
  - evt: bossIntro
    lines:
    - I AM THE MEGA DUMPSTER!
  openRange: 4.5
  lookRange: 14
  talkCooldown: 1.6
  napTime: 3
  awakeTime: 2
  bubble: {fileID: 3462761549781945120}
  bubbleText: {fileID: 4488581087076861902}
  lidHinge: {fileID: 5488895525411348987}
  pupilL: {fileID: 8962874076801815798}
  pupilR: {fileID: 6632936773160171600}
  lidCol: {fileID: 1432676144919748078}
  anim: {fileID: 0}
